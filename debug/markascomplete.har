eted\":false,\"embed_content\":\"<blockquote class='rg_standalone_container' data-src='//genius.com/annotations/35573281/standalone_embed'><a href='https://genius.com/35573281/Peacestar-to-the-light/To-the-light'>&quot;To the Light&quot;</a><br><a href='https://genius.com/Peacestar-to-the-light-lyrics'>&#8213; Peacestar (Ft. Ayram, Jezreel Nessie & Miracle Joshua) – \\\"To the Light\\\"</a></blockquote><script async crossorigin src='//genius.com/annotations/load_standalone_embeds.js'></script>\",\"has_voters\":false,\"id\":35573281,\"needs_exegesis\":true,\"pinned\":false,\"proposed_edit_count\":0,\"pyongs_count\":null,\"referent_id\":35573281,\"share_url\":\"https://genius.com/35573281\",\"source\":null,\"state\":\"needs_exegesis\",\"twitter_share_message\":\"“?” —@Genius\",\"url\":\"https://genius.com/35573281/Peacestar-to-the-light/To-the-light\",\"verified\":false,\"votes_total\":0,\"current_user_metadata\":{\"permissions\":[\"edit\",\"report_as_abusive\"],\"excluded_permissions\":[\"vote\",\"cosign\",\"uncosign\",\"destroy\",\"accept\",\"reject\",\"see_unreviewed\",\"clear_votes\",\"propose_edit_to\",\"pin_to_profile\",\"unpin_from_profile\",\"update_source\",\"edit_custom_preview\",\"create_comment\"],\"interactions\":{\"cosign\":false,\"pyong\":false,\"vote\":null},\"iq_by_action\":{\"accept\":{\"primary\":{\"multiplier\":1,\"base\":10.0,\"applicable\":true}},\"reject\":{\"primary\":{\"multiplier\":1,\"base\":2.0,\"applicable\":true}},\"delete\":{\"primary\":{\"multiplier\":1,\"base\":5.0,\"applicable\":false}}}},\"accepted_by\":null,\"authors\":[{\"_type\":\"user_attribution\",\"attribution\":1.0,\"pinned_role\":null,\"user\":{\"_type\":\"user\",\"about_me_summary\":\"HE’S BACKKKKKKK\\n\\n✦ achievements here ✦\\n\\naspiring editor\\nbest works I’m proud of:\\ntates: 1, 2, 3, 4, 5\\nartist bios: 1, 2, 3\\nsong bio: 1\\nalbum bio: 1\\n⁕\\n\\n\\n\\n\\nI’m on a mission; don’t distract me.\\nOne RRR, one day! You can join too, here. (so much for staying consistent)\\n\\n3,000 IQ – May 24, 2025\\n4,000 IQ – August 1, 2025\\n5,000 IQ – August 29, 2025 (1000 IQ in one month is crazy! – for me)\\n6,000 IQ – September 7, 2025 (I’m on crack)\\n\\nWas granted the transcriber role between these dates.\\n\\n7,000 IQ – September 13, 2025 (Dedication)\\n8,000 IQ – September 26, 2025 (I gotta do my job, ya know)\\n9,000 IQ – October 4, 2025 (Power!)\\n13,000 IQ – October 5, 2025 (Some may say I was high on meth for this kind of leap, lol)\\nFUN FACT: I also reached Top 3 on the leaderboard today :)\\n15,000 IQ – I don’t even know when I reached 15k, but it should be around November 1, 2025.\\n16,000 IQ – November 7, 2025\\n18,000 IQ – November 8, 2025\\n19,000 IQ – November 9, 2025\\n22,000 IQ – November 10, 2025\\n(Haven’t been keeping track, damn)\\n27,000 IQ – November 15, 2025 – All Hail the Scribe Series\\nDecember 12, 2025 – Bro fumbled!\\n33,700 IQ – December 23, 2025\\n\\n2026 – New year, new role (I beg of thee)\\n\\n34,400 IQ – January 4, 2026\\n36,000 IQ – January 11, 2026\\n37,400 IQ – January 13, 2026\\n38,200 IQ – January 20, 2026\\n39,300 IQ – January 29, 2026\\n\\nThank you so much! I’ve been reinstated, guys!!! – April 27, 2026\\n\\n43,300 IQ – April 28, 2026\\n51,755 IQ – June 24, 2026\\n\\n\\n\\n\\n\\n\\nPre 25K IQ graph (in 2025)\",\"api_path\":\"/users/22696076\",\"avatar\":{\"tiny\":{\"url\":\"https://images.genius.com/avatars/tiny/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":16,\"height\":16}},\"thumb\":{\"url\":\"https://images.genius.com/avatars/thumb/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":32,\"height\":32}},\"small\":{\"url\":\"https://images.genius.com/avatars/small/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":100,\"height\":100}},\"medium\":{\"url\":\"https://images.genius.com/avatars/medium/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":300,\"height\":400}}},\"header_image_url\":\"https://assets.genius.com/images/default_banner.png?1787067299\",\"human_readable_role_for_display\":\"Transcriber\",\"id\":22696076,\"iq\":83933,\"is_meme_verified\":false,\"is_verified\":false,\"login\":\"infinitehoax\",\"name\":\"infinitehoax\",\"role_for_display\":\"transcriber\",\"url\":\"https://genius.com/infinitehoax\",\"current_user_metadata\":{\"permissions\":[],\"excluded_permissions\":[\"follow\"],\"interactions\":{\"following\":false}}}}],\"cosigned_by\":[],\"created_by\":{\"_type\":\"user\",\"about_me_summary\":\"HE’S BACKKKKKKK\\n\\n✦ achievements here ✦\\n\\naspiring editor\\nbest works I’m proud of:\\ntates: 1, 2, 3, 4, 5\\nartist bios: 1, 2, 3\\nsong bio: 1\\nalbum bio: 1\\n⁕\\n\\n\\n\\n\\nI’m on a mission; don’t distract me.\\nOne RRR, one day! You can join too, here. (so much for staying consistent)\\n\\n3,000 IQ – May 24, 2025\\n4,000 IQ – August 1, 2025\\n5,000 IQ – August 29, 2025 (1000 IQ in one month is crazy! – for me)\\n6,000 IQ – September 7, 2025 (I’m on crack)\\n\\nWas granted the transcriber role between these dates.\\n\\n7,000 IQ – September 13, 2025 (Dedication)\\n8,000 IQ – September 26, 2025 (I gotta do my job, ya know)\\n9,000 IQ – October 4, 2025 (Power!)\\n13,000 IQ – October 5, 2025 (Some may say I was high on meth for this kind of leap, lol)\\nFUN FACT: I also reached Top 3 on the leaderboard today :)\\n15,000 IQ – I don’t even know when I reached 15k, but it should be around November 1, 2025.\\n16,000 IQ – November 7, 2025\\n18,000 IQ – November 8, 2025\\n19,000 IQ – November 9, 2025\\n22,000 IQ – November 10, 2025\\n(Haven’t been keeping track, damn)\\n27,000 IQ – November 15, 2025 – All Hail the Scribe Series\\nDecember 12, 2025 – Bro fumbled!\\n33,700 IQ – December 23, 2025\\n\\n2026 – New year, new role (I beg of thee)\\n\\n34,400 IQ – January 4, 2026\\n36,000 IQ – January 11, 2026\\n37,400 IQ – January 13, 2026\\n38,200 IQ – January 20, 2026\\n39,300 IQ – January 29, 2026\\n\\nThank you so much! I’ve been reinstated, guys!!! – April 27, 2026\\n\\n43,300 IQ – April 28, 2026\\n51,755 IQ – June 24, 2026\\n\\n\\n\\n\\n\\n\\nPre 25K IQ graph (in 2025)\",\"api_path\":\"/users/22696076\",\"avatar\":{\"tiny\":{\"url\":\"https://images.genius.com/avatars/tiny/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":16,\"height\":16}},\"thumb\":{\"url\":\"https://images.genius.com/avatars/thumb/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":32,\"height\":32}},\"small\":{\"url\":\"https://images.genius.com/avatars/small/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":100,\"height\":100}},\"medium\":{\"url\":\"https://images.genius.com/avatars/medium/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":300,\"height\":400}}},\"header_image_url\":\"https://assets.genius.com/images/default_banner.png?1787067299\",\"human_readable_role_for_display\":\"Transcriber\",\"id\":22696076,\"iq\":83933,\"is_meme_verified\":false,\"is_verified\":false,\"login\":\"infinitehoax\",\"name\":\"infinitehoax\",\"role_for_display\":\"transcriber\",\"url\":\"https://genius.com/infinitehoax\",\"current_user_metadata\":{\"permissions\":[],\"excluded_permissions\":[\"follow\"],\"interactions\":{\"following\":false}}},\"rejection_comment\":null,\"top_comment\":null,\"verified_by\":null}]},\"featured_artists\":[{\"_type\":\"artist\",\"api_path\":\"/artists/4439184\",\"header_image_url\":\"https://assets.genius.com/images/default_banner.png?1787067299\",\"id\":4439184,\"image_url\":\"https://assets.genius.com/images/default_cover_image.png?1787067299\",\"index_character\":\"j\",\"is_meme_verified\":false,\"is_verified\":false,\"links_config\":null,\"name\":\"Jezreel Nessie\",\"slug\":\"Jezreel-nessie\",\"url\":\"https://genius.com/artists/Jezreel-nessie\"},{\"_type\":\"artist\",\"api_path\":\"/artists/1667736\",\"header_image_url\":\"https://assets.genius.com/images/default_banner.png?1787067299\",\"id\":1667736,\"image_url\":\"https://assets.genius.com/images/default_cover_image.png?1787067299\",\"index_character\":\"a\",\"is