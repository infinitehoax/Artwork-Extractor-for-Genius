2026\\n37,400 IQ – January 13, 2026\\n38,200 IQ – January 20, 2026\\n39,300 IQ – January 29, 2026\\n\\nThank you so much! I’ve been reinstated, guys!!! – April 27, 2026\\n\\n43,300 IQ – April 28, 2026\\n51,755 IQ – June 24, 2026\\n\\n\\n\\n\\n\\n\\nPre 25K IQ graph (in 2025)\",\"api_path\":\"/users/22696076\",\"avatar\":{\"tiny\":{\"url\":\"https://images.genius.com/avatars/tiny/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":16,\"height\":16}},\"thumb\":{\"url\":\"https://images.genius.com/avatars/thumb/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":32,\"height\":32}},\"small\":{\"url\":\"https://images.genius.com/avatars/small/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":100,\"height\":100}},\"medium\":{\"url\":\"https://images.genius.com/avatars/medium/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":300,\"height\":400}}},\"header_image_url\":\"https://assets.genius.com/images/default_banner.png?1786736927\",\"human_readable_role_for_display\":\"Transcriber\",\"id\":22696076,\"iq\":65387,\"is_meme_verified\":false,\"is_verified\":false,\"login\":\"infinitehoax\",\"name\":\"infinitehoax\",\"role_for_display\":\"transcriber\",\"url\":\"https://genius.com/infinitehoax\",\"current_user_metadata\":{\"permissions\":[],\"excluded_permissions\":[\"follow\"],\"interactions\":{\"following\":false}}}},\"translation_songs\":[],\"verified_annotations_by\":[],\"verified_contributors\":[],\"verified_lyrics_by\":[],\"writer_artists\":[{\"_type\":\"artist\",\"api_path\":\"/artists/2360610\",\"header_image_url\":\"https://images.genius.com/5493a8bb572b1788995645e0ba5c0a9b.1000x667x1.jpg\",\"id\":2360610,\"image_url\":\"https://images.genius.com/5493a8bb572b1788995645e0ba5c0a9b.1000x667x1.jpg\",\"index_character\":\"b\",\"is_meme_verified\":false,\"is_verified\":false,\"links_config\":null,\"name\":\"Braver\",\"slug\":\"Braver\",\"url\":\"https://genius.com/artists/Braver\"},{\"_type\":\"artist\",\"api_path\":\"/artists