om/avatars/small/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":100,\"height\":100}},\"medium\":{\"url\":\"https://images.genius.com/avatars/medium/b6dc8fdf32d3c76625d3e8432cebc7a6\",\"bounding_box\":{\"width\":300,\"height\":400}}},\"header_image_url\":\"https://assets.genius.com/images/default_banner.png?1786736927\",\"human_readable_role_for_display\":\"Transcriber\",\"id\":22696076,\"iq\":65667,\"is_meme_verified\":false,\"is_verified\":false,\"login\":\"infinitehoax\",\"name\":\"infinitehoax\",\"role_for_display\":\"transcriber\",\"url\":\"https://genius.com/infinitehoax\",\"current_user_metadata\":{\"permissions\":[],\"excluded_permissions\":[\"follow\"],\"interactions\":{\"following\":false}}}},\"translation_songs\":[],\"verified_annotations_by\":[],\"verified_contributors\":[],\"verified_lyrics_by\":[],\"writer_artists\":[]}}}"
