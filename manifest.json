{
"update_url": "https://clients2.google.com/service/update2/crx",

    "manifest_version": 3,
    "name": "Genius+",
    "version": "0.1.0",
    "description": "Edit a whole Genius album's credits in one table, import songs and credits from Apple Music, and save artwork full size.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Genius+",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "https://*.mzstatic.com/*",
        "https://*.sndcdn.com/*",
        "https://music.apple.com/*",
        "https://amp-api.music.apple.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://genius.com/*",
                "https://*.genius.com/*"
            ],
            "js": [
                "content/genius.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://genius.com/*",
                "https://*.genius.com/*"
            ],
            "js": [
                "content/genius-main.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://soundcloud.com/*",
                "https://m.soundcloud.com/*"
            ],
            "js": [
                "content/soundcloud.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://soundcloud.com/*",
                "https://m.soundcloud.com/*"
            ],
            "js": [
                "content/soundcloud-main.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://music.apple.com/*"
            ],
            "js": [
                "content/apple-music.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://genius.com/new/import",
                "https://*.genius.com/new/import"
            ],
            "js": [
                "content/genius-early.js"
            ],
            "run_at": "document_start"
        }
    ]
}
